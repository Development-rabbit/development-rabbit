# Copy this file to .env and fill in real values. .env is gitignored —
# never commit real secrets.

PORT=3000

# MongoDB connection string, without the database name (the app appends
# the database name from src/constants.js itself).
MONGODB_URI=

# Comma-separated list of allowed frontend origins for production, e.g.
# https://developmentrabbit.com,https://www.developmentrabbit.com — localhost
# is always allowed on top of this, so it's fine to leave blank for local dev.
CORS_ORIGIN=

# Random secret strings used to sign JWTs — NOT a token itself, just a
# long random string (e.g. `openssl rand -hex 32`).
ACCESS_TOKEN_SECRET=
ACCESS_TOKEN_EXPIRY=1d
REFRESH_TOKEN_SECRET=
REFRESH_TOKEN_EXPIRY=10d

# Razorpay — https://dashboard.razorpay.com/app/keys
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# Bunny Stream — video hosting for course lessons.
# https://dash.bunny.net -> Stream -> your library -> API
BUNNY_STREAM_LIBRARY_ID=
BUNNY_STREAM_API_KEY=
BUNNY_STREAM_CDN_HOSTNAME=

# Bunny Storage — general file host for course/content thumbnails and
# note attachments. Create a Storage Zone + connect a Pull Zone to it at
# https://dash.bunny.net, then fill these in from the zone's Access tab.
BUNNY_STORAGE_ZONE_NAME=
BUNNY_STORAGE_API_KEY=
# Bare hostname or full URL both work (e.g. "zone.b-cdn.net" or
# "https://zone.b-cdn.net/").
BUNNY_STORAGE_CDN_HOSTNAME=
# Only needed if your storage zone's main region isn't the default —
# find the right one on the zone's Access tab. Defaults to storage.bunnycdn.com.
# BUNNY_STORAGE_ENDPOINT=

# Google OAuth — https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=

# GitHub OAuth — https://github.com/settings/developers
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
