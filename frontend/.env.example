# Copy this file to .env and fill in real values. .env is gitignored —
# never commit real secrets.

# Backend API base URL, including the /api/v1 prefix.
VITE_API_BASE_URL=http://localhost:3000/api/v1

# Google OAuth client ID — must match the backend's GOOGLE_CLIENT_ID.
# https://console.cloud.google.com/apis/credentials
VITE_GOOGLE_CLIENT_ID=

# GitHub OAuth client ID — must match the backend's GITHUB_CLIENT_ID.
# https://github.com/settings/developers
VITE_GITHUB_CLIENT_ID=
